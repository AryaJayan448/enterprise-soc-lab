// Hunt: Windows process creation (4688) - rare processes and abusable tools
// Not a scheduled rule: run manually in Logs, time range 7 days.
// Requires "Include command line in process creation events" (registry
// HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\Audit\ProcessCreationIncludeCmdLine_Enabled = 1)
// otherwise CommandLine is empty.
//
// Query 1 - rarest processes first (mostly boot-time services on a lab VM; rare != malicious)
SecurityEvent
| where EventID == 4688
| summarize Executions = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by NewProcessName
| order by Executions asc
| take 20

// Query 2 - user-writable paths and commonly abused tools, with parent and command line
SecurityEvent
| where EventID == 4688
| where NewProcessName has_any ("\\Temp\\", "\\Downloads\\", "\\AppData\\", "\\Users\\Public\\", "powershell", "cmd.exe", "certutil", "mshta", "rundll32", "wscript", "cscript", "bitsadmin")
| project TimeGenerated, SubjectUserName, NewProcessName, ParentProcessName, CommandLine
| order by TimeGenerated desc
| take 30
